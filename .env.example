# ---- Supabase (auth + database + audio storage) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres URI (Project Settings > Database). Only needed to run migrations.
SUPABASE_DB_URL=

# ---- Claude (content generation - fixed by scope AI-2) ------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Gemini (fallback for generation AND transcription) -----------------
# Used only when ANTHROPIC_API_KEY / the transcription keys are blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Minds / OneVoice memory (fixed by scope AI-3) ----------------------
MINDS_API_KEY=
# Leave blank to auto-detect (api.mindshub.ai). Set to pin a specific base.
MINDS_BASE_URL=

# ---- Transcription (AI-1: developer's choice) ---------------------------
# Set ONE of these. Provider is auto-detected in this order.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
