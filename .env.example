# Required for production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Generation and edit-derived memory suggestions. Gemini is the default.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Claude alternative
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Optional remote sync for OneVoice. Local OneVoice works without Minds.
MINDS_API_KEY=
MINDS_BASE_URL=https://api.getminds.ai/v1

# Uploaded-audio transcription
DEEPGRAM_API_KEY=

# Google OAuth (email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional local persistence path
REWORD_DATA_FILE=.data/reword.json
